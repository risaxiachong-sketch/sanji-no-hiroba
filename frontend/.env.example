# Optional: force deterministic mock data even when a backend is configured.
# VITE_USE_MOCK=true

# Priority 1: an existing AWS API Gateway backend.
# VITE_API_BASE_URL=https://example.execute-api.ap-northeast-1.amazonaws.com/prod

# Priority 2: Firebase Spark. Set all four required values to enable Firebase
# when VITE_API_BASE_URL is absent. Without either backend, mock mode is used.
# VITE_FIREBASE_API_KEY=your-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=your-web-app-id
# Enable the Google provider in Firebase Authentication and add every deployed
# hostname to Authentication > Settings > Authorized domains.

# Optional values from the Firebase web app configuration.
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Optional Firebase App Check (reCAPTCHA Enterprise) site key.
# VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
